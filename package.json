{
  "name": "urunankita-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "urunankita - Multi-tenant Community Billing & Bookkeeping Engine",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=@urunankita/backend",
    "dev:frontend": "npm run dev --workspace=@urunankita/frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace=@urunankita/backend",
    "build:frontend": "npm run build --workspace=@urunankita/frontend",
    "test": "npm run test --workspace=@urunankita/backend",
    "lint": "npm run lint --workspace=@urunankita/backend",
    "typecheck": "npm run typecheck --workspace=@urunankita/backend",
    "prisma:generate": "npm run prisma:generate --workspace=@urunankita/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=@urunankita/backend",
    "prisma:seed": "npm run prisma:seed --workspace=@urunankita/backend"
  },
  "keywords": [
    "billing",
    "qris",
    "community",
    "monorepo",
    "nestjs",
    "nuxt3",
    "prisma"
  ],
  "author": "",
  "license": "MIT"
}
